: "audio", "title": "", "_data": [], "template_override": 1, "contents": [{"type": "slideshow", "value": {"audiosrc": "engenn4le14ob09re2aud01", "coverimg": "engenn4le14ob09re2img01.jpg", "images": [{"text": "", "id": 0, "time": "0", "image": "engenn4le14ob09re2img05.jpg"}, {"text": "<span class=\"strong\">Ranger</span>: What's the problem, Miss?<br>\n<span class=\"strong\">Vanessa</span>: I hurt my ankle.<br/>\n<span class=\"strong\">Ranger</span>: Where is the pain?<br>\n<span class=\"strong\">Vanessa</span>: My whole foot is throbbing!<br/>\n<span class=\"strong\">Ranger</span>: Please sit down. Put your leg up on this chair.<br>\n<span class=\"strong\">Vanessa</span>: It really hurts just above the heel.", "id": 1, "time": "1", "image": "engenn4le14ob09re2img05.jpg"}, {"text": "<span class=\"strong\">Ranger</span>: Yes, it's a little swollen there.<br>\n<span class=\"strong\">Vanessa</span>: Oh, what should I do?<br>\n<span class=\"strong\">Ranger</span>: Don't worry. We should ice it and then wrap it tight.<br/>\n<span class=\"strong\">Vanessa</span>: Can I walk back?<br>\n<span class=\"strong\">Ranger</span>: No. You must keep it elevated. You must also use a crutch to walk.<br>\n<span class=\"strong\">Vanessa</span>: Oh, I'm not moving for a while.<br>\n<span class=\"strong\">Ranger</span>: You should also take some medication to reduce the pain.", "id": 2, "time": "12000", "image": "engenn4le14ob09re2img01.jpg"}, {"text": "<span class=\"strong\">Vanessa</span>: I'm taking it easy for sure.<br>\n<span class=\"strong\">Ranger</span>: You must stay off your foot for a while. <br>\n<span class=\"strong\">Vanessa</span>: How do I get back?<br/>\n<span class=\"strong\">Ranger</span>: We airlift patients. <br/>\n<span class=\"strong\">Vanessa</span>: Sally! We're taking a helicopter!<br>\n<span class=\"strong\">Sally</span>: Just don't look down!", "id": 3, "time": "32500", "image": "engenn4le14ob09re2img02.jpg"}]}}]}, {"_data": [], "id": 2, "type": "text", "title": "", "contents": [{"type": "p", "value": "<span class=\"strong\">Ranger</span>: What's the problem, Miss?<br>\n<span class=\"strong\">Vanessa</span>: I hurt my ankle.<br/>\n<span class=\"strong\">Ranger</span>: Where is the pain?<br>\n<span class=\"strong\">Vanessa</span>: My whole foot is throbbing!<br/>\n<span class=\"strong\">Ranger</span>: Please sit down. Put your leg up on this chair.<br>\n<span class=\"strong\">Vanessa</span>: It really hurts just above the heel.<br/><span class=\"strong\">Ranger</span>: Yes, it's a little swollen there.<br>\n<span class=\"strong\">Vanessa</span>: Oh, what should I do?<br>\n<span class=\"strong\">Ranger</span>: Don't worry. We should ice it and then wrap it tight.<br/>\n<span class=\"strong\">Vanessa</span>: Can I walk back?<br>\n<span class=\"strong\">Ranger</span>: No. You must keep it elevated. You must also use a crutch to walk.<br>\n<span class=\"strong\">Vanessa</span>: Oh, I'm not moving for a while.<br>\n<span class=\"strong\">Ranger</span>: You should also take some medication to reduce the pain.<br/>\n<span class=\"strong\">Vanessa</span>: I'm taking it easy for sure.<br>\n<span class=\"strong\">Ranger</span>: You must stay off your foot for a while. <br>\n<span class=\"strong\">Vanessa</span>: How do I get back?<br/>\n<span class=\"strong\">Ranger</span>: We airlift patients. <br/>\n<span class=\"strong\">Vanessa</span>: Sally! We're taking a helicopter!<br>\n<span class=\"strong\">Sally</span>: Just don't look down!"}]}]}], "type": "sena"}