{"_data": [{"contents": [{"content": "Sally and Vanessa Visit the Grand Canyon", "type": "lesson_name"}, {"content": "What Should We Do?", "type": "unit_name"}, {"content": 6, "type": "position"}, {"content": "scholar > Nature Around Us > Greetings From Alaska", "type": "origin"}, {"content": 14, "type": "lesson"}, {"content": "A2.1", "type": "level"}], "type": "metadata"}, {"contents": [{"content": "false", "type": "test"}], "type": "achievment_test"}, {"contents": [{"content": "Accurately use information about travel and vacations in social situations.", "type": "primary"}, {"content": "Identifies general information in short written or spoken conversations about advice for a healthy lifestyle. ", "type": "secondary_1"}, {"content": "Gives appropriate directions to places taking into account the type of interlocutor.", "type": "secondary_2"}, {"content": "Gives appropriate directions to places taking into account the type of interlocutor.", "type": "secondary_3"}, {"content": "Gives appropriate directions to places taking into account the type of interlocutor.", "type": "secondary_4"}, {"content": "Identifies general information in short written or spoken conversations about advice for a healthy lifestyle. ", "type": "secondary_5"}, {"content": "Identifies general information in short written or spoken conversations about advice for a healthy lifestyle. ", "type": "secondary_6"}, {"content": "Identifies general information in short written or spoken conversations about advice for a healthy lifestyle. ", "type": "secondary_7"}, {"content": "Identifies general information in short written or spoken conversations about advice for a healthy lifestyle. ", "type": "secondary_8"}], "type": "objectives"}, {"contents": [{"content": "chopper ", "type": "name"}, {"content": "another way to say helicopter", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: We can take a chopper ride above the canyon.", "type": "example"}, {"content": "engenn4le14ob06aud02", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "These are words you hear when you are on vacation.", "type": "text"}], "type": "target_word_describer"}, {"contents": [{"content": "Are you in?", "type": "name"}, {"content": "Do you agree to this?", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: I'm going on the chopper. Are you in?", "type": "example"}, {"content": "engenn4le14ob06aud01", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "to spoil ", "type": "name"}, {"content": "to damage; to destroy", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: I didn't want to spoil the adventure.", "type": "example"}, {"content": "engenn4le14ob06aud08", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "halfway", "type": "name"}, {"content": "in the middle of", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: The camp is halfway up the mountain.", "type": "example"}, {"content": "engenn4le14ob06aud03", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "rest stop", "type": "name"}, {"content": "a place to relax before continuing", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: There are rest stops along the trail.", "type": "example"}, {"content": "engenn4le14ob06aud05", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "take our time", "type": "name"}, {"content": "you don't need to hurry", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: We can take our time on the walk.", "type": "example"}, {"content": "engenn4le14ob06aud07", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "mule", "type": "name"}, {"content": "an animal that is part horse and part donkey", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Mules carry people into the canyon.", "type": "example"}, {"content": "engenn4le14ob06aud04", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "rim", "type": "name"}, {"content": "the outer edge of something round", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: We start the hike on the rim of the canyon. ", "type": "example"}, {"content": "engenn4le14ob06aud06", "type": "audio"}], "type": "target_word"}, {"content": "engenn4le14ob06re1img01.jpg", "type": "background_image"}, {"contents": [{"content": "Asking for and Responding to Suggestions ", "type": "heading"}, {"content": "You make suggestions when you want to decide on an activity with friends. You also give advice on what someone can do in a certain situation. ", "type": "describer"}, {"content": "{\"rows\":6,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Asking  for Suggestions\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Responding to Suggestions\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">Why not take our time and enjoy the day?</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\"> That's a good idea.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">Let's think about the Cottonwood trail. </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">That sounds okay.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">What about sitting at the rest stop for a while? </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">Yes, please! I'm so tired!</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">So what about taking the chopper tour?  </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">I'm sorry but I'm not good with heights. </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">How about taking a walk?</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">I'd like that.</span>\\\"}\"],\"styles\":\" instruction_table_background intro_table_border\"}", "type": "table"}], "type": "learning_points"}, {"contents": [{"content": "What types of adventures do you want to have?", "type": "text"}, {"content": "Make a list of 5 things you think are exciting.", "type": "text"}, {"content": "Say when you want to try them.", "type": "text"}, {"content": "Read your list with a partner.", "type": "text"}, {"content": "Listen to your partner's list.", "type": "text"}], "type": "takeaway_extension"}, {"contents": [{"content": "I write a list of adventures.", "type": "text"}, {"content": "I read my list of adventures aloud.", "type": "text"}, {"content": "I listen to a partner read their list.", "type": "text"}, {"content": "I use target words when making my list.", "type": "text"}], "type": "takeaway_assessment"}], "labs": [{"stimuli": [{"type": "welcome", "_data": [], "contents": [{}], "id": 0, "template_override": 1}, {"title": "", "contents": [{"value": {"audiosrc": "engenn4le14ob06re2aud01", "images": [{"image": "engenn4le14ob06re2img05.jpg", "id": 0, "time": "0", "text": ""}, {"image": "engenn4le14ob06re2img05.jpg", "id": 1, "time": "1", "text": "<span class=\"strong\">Sally</span>: So ... what about taking the chopper tour? Are you in?<br>\n<span class=\"strong\">Vanessa</span>: I don't know. I am sorry, but I'm not good with heights.<br>\n<span class=\"strong\">Sally</span>: What! Why didn't you tell me?<br>\n<span class=\"strong\">Vanessa</span>: I didn't want to spoil the adventure!"}, {"image": "engenn4le15ob06re2img01.jpg", "id": 2, "time": "14200", "text": "<span class=\"strong\">Sally</span>: How about going on a mule ride?<br>\n<s