nts": [{"type": "name", "content": "rest stop"}, {"type": "definition", "content": "a place to relax before continuing"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: There are rest stops along the trail."}, {"type": "audio", "content": "engenn4le14ob06aud05"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "take our time"}, {"type": "definition", "content": "you don't need to hurry."}, {"type": "part_speech", "content": "(expression)"}, {"type": "example", "content": "Example: We can take our time on the walk."}, {"type": "audio", "content": "engenn4le14ob06aud07"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "mule"}, {"type": "definition", "content": "an animal that is part horse and part donkey"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: Mules carry people into the canyon."}, {"type": "audio", "content": "engenn4le14ob06aud04"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "rim"}, {"type": "definition", "content": "the outer edge of something round"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: We start the hike on the rim of the canyon. "}, {"type": "audio", "content": "engenn4le14ob06aud06"}]}, {"type": "background_image", "content": "engenn4le14ob06re1img01.jpg"}, {"type": "learning_points", "contents": [{"type": "heading", "content": "Asking for and Responding to Suggestions "}, {"type": "describer", "content": "You make suggestions when you want to decide on an activity with friends. You also give advice on what someone can do in a certain situation. "}, {"type": "table", "content": "{\"rows\":6,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Asking  for Suggestions\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Responding to Suggestions\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">Why not take our time and enjoy the day?</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\"> That's a good idea.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">Let's think about the Cottonwood trail. </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">That sounds okay.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">What about sitting at the rest stop for a while? </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">Yes, please! I'm so tired!</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">So what about taking the chopper tour?  </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">I'm sorry but I'm not good with heights. </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">How about taking a walk?</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">I'd like that.</span>\\\"}\"],\"styles\":\" instruction_table_background intro_table_border\"}"}]}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "What types of adventures do you want to have?"}, {"type": "text", "content": "Make a list of 5 things you think are exciting."}, {"type": "text", "content": "Say when you want to try them."}, {"type": "text", "content": "Read your list with a partner."}, {"type": "text", "content": "Listen to your partner's list."}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "I write a list of adventures."}, {"type": "text", "content": "I read my list of adventures aloud."}, {"type": "text", "content": "I listen to a partner read their list."}, {"type": "text", "content": "I use target words when making my list."}]}], "type": "sena"}