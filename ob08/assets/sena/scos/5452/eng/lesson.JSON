{"_data": [{"type": "metadata", "contents": [{"content": "Sally and Vanessa Visit the Grand Canyon", "type": "lesson_name"}, {"content": "An Incident Report", "type": "unit_name"}, {"content": 8, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 14, "type": "lesson"}, {"content": "A2.1", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": "Relate information about health and healthy habits in communicative situations.", "type": "primary"}, {"content": "Describes common health conditions by the use of the correct expressions, vocabulary and grammatical structures related to the communicative topics for this level", "type": "secondary_1"}, {"content": "Identifies general information in short written or spoken conversations.", "type": "secondary_2"}, {"content": "Describes common health conditions by the use of the correct expressions, vocabulary and grammatical structures related to the communicative topics for this level", "type": "secondary_3"}, {"content": "Describes common health conditions by the use of the correct expressions, vocabulary and grammatical structures related to the communicative topics for this level", "type": "secondary_4"}, {"content": "Identifies general information in short written or spoken conversations.", "type": "secondary_5"}, {"content": "Identifies general information in short written or spoken conversations.", "type": "secondary_6"}, {"content": "Describes common health conditions by the use of the correct expressions, vocabulary and grammatical structures related to the communicative topics for this level", "type": "secondary_7"}, {"content": "Identifies general information in short written or spoken conversations.", "type": "secondary_8"}]}, {"type": "learning_points", "contents": [{"content": "Visiting the Doctor's Office", "type": "heading"}, {"content": "There are many ways to ask for and receive information at a doctor's office or a first aid station.", "type": "describer"}, {"content": "When you are <span class=\"strong\">at the reception</span>, you might hear phrases like:", "type": "text"}, {"content": "<span class=\"italic\">Do you have an appointment?<br> I'd like to see a doctor.<br> I would like to make an appointment.<br>Please take a seat.</span>", "type": "text"}, {"content": "You may <span class=\"strong\">hear</span> these phrases during your appointment:", "type": "text"}, {"content": "<span class=\"italic\">What are your symptoms?<br> How can I help you?<br> What's the problem?</span>", "type": "text"}, {"content": "You may <span class=\"strong\">use </span> these phrases during your appointment:", "type": "text"}, {"content": "<span class=\"italic\"> I've got a \u2026<br> <br>temperature<br> sore throat<br> headache</span>", "type": "text"}, {"content": "<span class=\"italic\">I think I twisted my ankle.</span>", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "to get off ", "type": "name"}, {"content": "to sit down, to take weight off a leg ", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: You should get off that ankle.", "type": "example"}, {"content": "engenn4le14ob08aud06", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": "These are words you hear when you receive first aid.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "oh brother  ", "type": "name"}, {"content": "a sign of frustration ", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: Oh brother! Now can you help her?", "type": "example"}, {"content": "engenn4le14ob08aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "assistance ", "type": "name"}, {"content": "the act of helping someone  ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: The ranger gave the hiker some assistance.", "type": "example"}, {"content": "engenn4le14ob08aud01", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "witness", "type": "name"}, {"content": "a person who sees an event ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Sally was a witness to the incident.", "type": "example"}, {"content": "engenn4le14ob08aud07", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to follow up", "type": "name"}, {"content": "to check something in the future", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": " Example: Let's follow up on this next week.", "type": "example"}, {"content": "engenn4le14ob08aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "incident", "type": "name"}, {"content": "a minor event", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: You have to complete an incident report.", "type": "example"}, {"content": "engenn4le14ob08aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "swollen ", "type": "name"}, {"content": "larger than usual", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: Vanessa's ankle is very swollen.", "type": "example"}, {"content": "engenn4le14ob08aud04", "type": "audio"}]}, {"content": "engenn4le14ob08re1img01.jpg", "type": "background_image"}, {"type": "takeaway_extension", "contents": [{"content": "Create a 2 minute role play with a partner.", "type": "text"}, {"content": " Imagine you are a ranger at a national park. Your partner is a hiker who injured himself/herself on a hiking trail.", "type": "text"}, {"content": "What is the injury? How can the ranger help?", "type": "text"}, {"content": "Ask for information to use in an incident report.", "type": "text"}, {"content": "Use the modals should and must to offer suggestions and recommendations.", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I create and act in a role play.", "type": "text"}, {"content": "I ask for information to use in incident report.", "type": "text"}, {"content": "I use modals when creating my incident report.", "type": "text"}]}], "labs": [{"stimuli": [{"_data": [], "type": "welcome", "contents": [{}], "id": 0, "template_override": 1}, {"id": 1, "contents": [{"value": {"audiosrc": "engenn4le14ob08re2aud01", "images": [{"image": "engenn4le14ob08re2img02.jpg", "id": 0, "text": "", "time": "0"}, {"image": "engenn4le14ob08re2img02.jpg", "id": 1, "text": "<span class=\"strong\">Vanessa</span>: Indian Garden, thank goodness.<br>\n<span class=\"strong\">Sally</span>: You should get off that foot right away. Your ankle is really swollen.", "time": "1"}, {"image": "engenn4le14ob08re2img01.jpg", "id": 2, "text": "<span class=\"strong\">Ranger</span>: Hello ladies. How can I help you? Ohhh \u2026 that looks painful! You should get some ice on that. </br>\n<span class=\"strong\">Vanessa</span>: It's very painful. I think I twisted it.", "time": "8000"}, {"image": "engenn4le14ob08re2img03.jpg", "id": 3, "text": "<span class=\"strong\">Ranger</span>: Unfortunately, you must complete an incident report before I can provide you with any pain medication or assistance.<br>\n<span class=\"strong\">Vanessa</span>: That's crazy! Sally, pass me that form and a pen.<br>\n<span class=\"strong\">Sally</span>: Can't she fill it in later? Why must she complete it right now?<br>", "time": "18000"}, {"image": "engenn4le14ob08re2img05.jpg", "id": 4, "text": "<span class=\"strong\">Vanessa</span>:  There are so many questions on this form too!<br>\n<span class=\"strong\">Sally</span>: Give it to me. I can complete it for you.<br>\n<span class=\"strong\">Vanessa</span>: My ankle is turning blue. Look at the bruise.<br/>\n<span class=\"strong\">Ranger</span>: Make sure that she signs the form herself. <br>\n<span class=\"strong\">Sally</span>: Oh brother... Yes, yes, there you go. Now can you please help her?", "time": "34700"}], "coverimg": "engenn4le14ob08re2img02.jpg"}, "type": "slideshow"}], "template_override": 1, "_data": [], "type": "audio", "title": ""}, {"id": 2, "contents": [{"value": {"images": [{"image": "", "id": 0, "text": "", "time": "0"}, {"image": "", "id": 1, "text": "<span class = \"bullet\" >An incident report</span>", "time": "5000"}, {"image": "", "id": 2, "text": "<span class = \"bullet\" >What does Vanessa write on the form?</span>", "time": "26000"}], "video_src": "engenn4le14ob08re3vid01"}, "type": "video"}], "template_override": 1, "_data": [], "type": "video", "title": ""}], "exercises": [{"id": 0, "template_override": 1, "stimuli_ids": [0], "img_path": "", "type": "WLC", "_data": [{"type": "instructions", "contents": [{"content": "I can describe health problems. ", "type": "Learning Outcomes"}, {"content": "I can express obligation.", "type": "Learning Outcomes"}, {"content": "I can write orders and/or instructions.", "type": "Learning Outcomes"}, {"content": "Have you injured yourself before? How?", "type": "Free Header Item"}, {"content": "Did you complete an incident report form?", "type": "Free Header Item"}]}, {"type": "group", "contents": [{"content": "Welcome", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct", "incorrect_feedback": [{"content": "try again", "type": "text"}, {"content": "Maybe next time", "type": "text"}], "attempt_feedback": [{"content": "You have 2 tries", "type": "text"}, {"content": "you have 1 attempt left", "type": "text"}], "allowed_attempts": 2}, "type": "feedback"}, {"content": "Ask your partner:", "type": "free_header_text"}, {"content": "Writing Spot: The Incident on Bright Angel Trail", "type": "free_type_text_area"}], "questions": []}, {"id": 1, "template_override": 1, "stimuli_ids": [1], "_data": [{"type": "instructions", "contents": [{"content": "Vanessa <span class=\"tool-tip\" id=\"tip_1_0\">hobbles</span> with Sally's help to a first aid c