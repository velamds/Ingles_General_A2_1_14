plate_override": 1, "_data": [], "type": "audio", "title": ""}, {"id": 2, "contents": [{"value": {"images": [{"image": "", "id": 0, "text": "", "time": "0"}, {"image": "", "id": 1, "text": "The Grand Canyon is located in the United States. It is close to the Utah and Nevada borders. It is one of the seven natural wonders of the world and an incredible place to visit!</p>", "time": "100"}, {"image": "", "id": 2, "text": "The canyon was created over millions of years by the water from the Colorado River. It is 277 miles long and 15 miles wide. At its deepest point, it is more than one mile from the top down to the river. Tourists have an opportunity to hike in an area, carved for 17 million years by a river.</p>", "time": "13000"}, {"image": "", "id": 3, "text": "In 1919, the Grand Canyon became a national park. Tourists  can learn about the history of Native Americans who lived near the canyon. Some considered the Grand Canyon a holy site, and made pilgrimages to it.", "time": "38000"}], "video_src": "engenn4le14ob04re2vid01"}, "type": "video"}], "template_override": 1, "_data": [], "type": "video", "title": ""}], "id": 0, "type": "scholar", "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}]}]}